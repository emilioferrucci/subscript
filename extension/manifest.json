{
  "manifest_version": 3,
  "name": "Subscript — Keep Underscores in ChatGPT",
  "version": "0.1.0",
  "description": "Keeps underscore-delimited text literal in ChatGPT's composer while preserving asterisk italics. Works alongside Still.",
  "host_permissions": ["https://chatgpt.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "subscript-chatgpt@emilioferrucci",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["none"]}
    }
  },
  "action": {
    "default_title": "Subscript — Keep Underscores in ChatGPT",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "content_scripts": [
    {"matches": ["https://chatgpt.com/*"], "js": ["guard.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://chatgpt.com/*"], "js": ["status.js"], "run_at": "document_start"}
  ]
}
